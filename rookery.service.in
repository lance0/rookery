[Unit]
Description=Rookery Inference Daemon
After=network.target nvidia-persistenced.service
# Stop rather than loop forever if the daemon can't start. Every restart cycle
# churns managed agents, so an unbounded loop is worse than a failed unit.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=@USER@
ExecStart=@BINDIR@/rookeryd
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=45
OOMScoreAdjust=-900
Environment=RUST_LOG=rookery=info
Environment=HF_HOME=@HF_HOME@
StandardOutput=journal
StandardError=journal
AmbientCapabilities=CAP_SYS_RESOURCE

[Install]
WantedBy=multi-user.target
